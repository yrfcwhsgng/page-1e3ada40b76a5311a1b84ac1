 .hero-desc {font-size: 17px;line-height: 1.65;color: var(--brown-500);margin-bottom: 36px}\n\n    .hero-desc p {margin-bottom: 8px}\n\n    /* 首屏内嵌锚点导航 */\n    .hero-nav {display: flex;flex-wrap: wrap;gap: 10px;padding-top: 12px;border-top: 1px solid var(--brown-100)}\n\n    .hero-nav a {font-size: 14px;font-weight: 600;color: var(--brown-800);background-color: var(--white);padding: 10px 18px;border-radius: 999px;border: 1px solid var(--brown-100);transition: all 0.2s ease;box-shadow: 0 2px 8px rgba(35, 25, 19, 0.03)}\n\n    .hero-nav a:hover {background-color: var(--brown-900);color: var(--mint-200);border-color: var(--brown-900)}\n\n    /* 右侧留白区构图 */\n    .hero-canvas {position: relative;height: 100%;min-height: 480px;display: flex;align-items: center;justify-content: flex-end;padding-left: 64px}\n\n    .hero-calm-panel {width: 100%;max-width: 380px;padding: 40px;background: linear-gradient(145deg, #ffffff 0%, var(--mint-050) 100%);border-radius: var(--radius-xl);box-shadow: var(--shadow-soft);border: 1px solid rgba(43, 153, 126, 0.15);position: relative}\n\n    .calm-meta-label {font-size: 12px;font-weight: 700;color: var(--brown-300);text-transform: uppercase;letter-spacing: 0.1em;margin-bottom: 12px}\n\n    .calm-meta-val {font-size: 28px;font-weight: 800;color: var(--brown-900);margin-bottom: 20px;line-height: 1.2}\n\n    .calm-list {list-style: none;border-top: 1px dashed var(--mint-200);padding-top: 18px}\n\n    .calm-list li {font-size: 14px;color: var(--brown-700);margin-bottom: 10px;display: flex;align-items: center;justify-content: space-between}\n\n    .calm-list li span:last-child {font-weight: 700;color: var(--mint-700)}\n\n    /* === 通用区段标题 === */\n    .section-wrap {padding: 96px 0 32px}\n\n    .section-header {margin-bottom: 48px}\n\n    .section-tag {font-size: 12px;font-weight: 700;letter-spacing: 0.1em;color: var(--mint-700);text-transform: uppercase;margin-bottom: 10px;display: block}\n\n    h2.section-title {font-size: 32px;font-weight: 800;letter-spacing: -0.01em;color: var(--brown-900);line-height: 1.25;margin-bottom: 12px}\n\n    .section-subtitle {font-size: 16px;color: var(--brown-500);max-width: 560px}\n\n    /* === 套餐方案：单列大卡依次堆叠 === */\n    .plans-stack {display: flex;flex-direction: column;gap: 32px}\n\n    .plan-card {background: var(--white);border-radius: var(--radius-xl);padding: 44px 48px;box-shadow: var(--shadow-soft);border: 1px solid var(--brown-100);display: grid;grid-template-columns: 280px 1fr auto;gap: 40px;align-items: center;position: relative;transition: box-shadow 0.25s ease, transform 0.25s ease}\n\n    .plan-card:hover {box-shadow: var(--shadow-hover);transform: translateY(-2px)}\n\n    .plan-card.is-featured {border: 2px solid var(--mint-400);background: linear-gradient(170deg, var(--white) 65%, var(--mint-050) 100%)}\n\n    .featured-badge {position: absolute;top: -14px;left: 48px;background-color: var(--mint-500);color: var(--white);font-size: 12px;font-weight: 700;padding: 4px 14px;border-radius: 999px;letter-spacing: 0.04em}\n\n    .plan-head-col h3 {font-size: 24px;font-weight: 800;color: var(--brown-900);margin-bottom: 12px}\n\n    .plan-price-box {display: flex;align-items: baseline;gap: 6px;margin-bottom: 8px}\n\n    .plan-price-main {font-size: 34px;font-weight: 800;color: var(--brown-900);letter-spacing: -0.02em}\n\n    .plan-price-sub {font-size: 13px;color: var(--brown-500);background: var(--brown-100);padding: 4px 10px;border-radius: var(--radius-sm);display: inline-block}\n\n    .plan-card.is-featured .plan-price-sub {background: var(--mint-100);color: var(--mint-900);font-weight: 600}\n\n    .plan-features-col {display: grid;grid-template-columns: repeat(2, 1fr);gap: 14px 28px;border-left: 1px solid var(--brown-100);padding-left: 40px}\n\n    .feature-item {font-size: 15px;color: var(--brown-700);display: flex;align-items: center;gap: 10px}\n\n    .feature-dot {width: 8px;height: 8px;border-radius: 50%;background-color: var(--mint-500);flex-shrink: 0}\n\n    .plan-cta-col {display: flex;flex-direction: column;justify-content: center;align-items: flex-end}\n\n    .btn-select {display: inline-block;white-space: nowrap;padding: 14px 28px;font-size: 15px;font-weight: 700;border-radius: 999px;background-color: var(--brown-900);color: var(--white);transition: background 0.2s ease, transform 0.15s ease}\n\n    .btn-select:hover {background-color: var(--mint-700)}\n\n    .plan-card.is-featured .btn-select {background-color: var(--mint-500);color: var(--white)}\n\n    .plan-card.is-featured .btn-select:hover {background-color: var(--mint-700)}\n\n    /* === 接入与终端指南 === */\n    .steps-grid {display: grid;grid-template-columns: repeat(3, 1fr);gap: 24px;margin-bottom: 32px}\n\n    .step-card {background: var(--white);border-radius: var(--radius-lg);padding: 36px 32px;box-shadow: var(--shadow-soft);border: 1px solid var(--brown-100)}\n\n    .step-num {font-size: 13px;font-weight: 800;letter-spacing: 0.1em;color: var(--mint-500);margin-bottom: 16px;display: block}\n\n    .step-card h3 {font-size: 19px;font-weight: 700;color: var(--brown-900);margin-bottom: 12px}\n\n    .step-card p {font-size: 14px;color: var(--brown-500);line-height: 1.6}\n\n    .clients-card {background: var(--white);border-radius: var(--radius-lg);padding: 40px;box-shadow: var(--shadow-soft);border: 1px solid var(--brown-100);display: grid;grid-template-columns: 1fr 1fr;gap: 40px;align-items: center}\n\n    .clients-card h3 {font-size: 20px;font-weight: 800;color: var(--brown-900);margin-bottom: 12px}\n\n    .clients-card p {font-size: 15px;color: var(--brown-500);line-height: 1.65}\n\n    .client-spec-badges {display: flex;flex-wrap: wrap;gap: 12px}\n\n    .badge-pill {font-size: 13px;font-weight: 600;padding: 8px 18px;background-color: var(--brown-050);border: 1px solid var(--brown-100);border-radius: 999px;color: var(--brown-700)}\n\n    /* === FAQ：details 折叠 === */\n    .faq-wrapper {display: flex;flex-direction: column;gap: 18px;max-width: 860px}\n\n    details.faq-item {background: var(--white);border-radius: var(--radius-lg);border: 1px solid var(--brown-100);box-shadow: var(--shadow-soft);overflow: hidden;transition: border-color 0.2s ease}\n\n    details.faq-item[open] {border-color: var(--mint-400)}\n\n    summary.faq-header {padding: 24px 32px;cursor: pointer;display: flex;align-items: center;justify-content: space-between;list-style: none;user-select: none}\n\n    summary.faq-header::-webkit-details-marker {display: none}\n\n    summary.faq-header h3 {font-size: 17px;font-weight: 700;color: var(--brown-900);padding-right: 20px}\n\n    .faq-toggle-icon {width: 28px;height: 28px;border-radius: 50%;background-color: var(--mint-050);color: var(--mint-700);display: flex;align-items: center;justify-content: center;font-size: 18px;font-weight: 400;flex-shrink: 0;transition: transform 0.2s ease, background 0.2s ease}\n\n    details.faq-item[open] .faq-toggle-icon {transform: rotate(45deg);background-color: var(--mint-100);color: var(--mint-900)}\n\n    .faq-body {padding: 0 32px 28px;font-size: 15px;color: var(--brown-500);line-height: 1.7;border-top: 1px solid var(--brown-050);margin-top: 4px;padding-top: 18px}\n\n    /* === 页脚 === */\n    .site-footer {margin-top: 120px;padding: 48px 0;border-top: 1px solid var(--brown-100);background: var(--white)}\n\n    .footer-content {display: flex;justify-content: space-between;align-items: center;flex-wrap: wrap;gap: 20px}\n\n    .footer-brand {font-size: 16px;font-weight: 800;letter-spacing: 0.05em;color: var(--brown-900)}\n\n    .footer-note {font-size: 13px;color: var(--brown-300)}\n\n    /* === 响应式断点 === */\n    @media (max-width: 960px) {.hero-stage {\n        grid-template-columns: 1fr;min-height: auto;padding: 48px 0;gap: 40px;}\n\n      .hero-canvas {\n        padding-left: 0;justify-content: flex-start;}\n\n      .hero-calm-panel {\n        max-width: 100%;}\n\n      .plan-card {\n        grid-template-columns: 1fr;gap: 28px;padding: 32px;}\n\n      .plan-features-col {\n        border-left: none;padding-left: 0;border-top: 1px solid var(--brown-100);padding-top: 24px;}\n\n      .plan-cta-col {\n        align-items: flex-start;}\n\n      .steps-grid {\n        grid-template-columns: 1fr;}\n\n      .clients-card {\n        grid-template-columns: 1fr;}}\n\n    @media (max-width: 600px) {\n      h1.hero-title {font-size: 32px}\n\n      .plan-features-col {grid-template-columns: 1fr}\n\n      .plan-card {padding: 28px 20px}\n\n      .featured-badge {left: 20px}\n\n      summary.faq-header {padding: 20px}\n\n      .faq-body {padding: 0 20px 20px}\n    }\n  </style><main>\n    <div class=\"wrap\">\n      \n      \n      <section class=\"hero-stage\">\n        <div class=\"hero-col\">\n          <span class=\"hero-eyebrow\">架构就绪 · 实时调度</span>\n          <h1 class=\"hero-title\">BLUEDAIR 节点订阅与数据分流方案</h1>\n          \n          <div class=\"hero-desc\">\n            <p>通道清晰。按需交付。</p>\n            <p>全系节点实施周期轮替维护。提供标准订阅凭证下发与多端规则分流。即刻配置，随时接入。</p>\n          </div>\n\n          \n          <nav class=\"hero-nav\" aria-label=\"页面区块导航\">\n            <a href=\"#plans\">订阅规格</a>\n            <a href=\"#setup\">接入流程</a>\n            <a href=\"#clients\">终端支持</a>\n            <a href=\"#faq\">常见问题</a>\n          </nav>\n        </div>\n\n        \n        <div class=\"hero-canvas\">\n          <div class=\"hero-calm-panel\">\n            <div class=\"calm-meta-label\">网络运行基准</div>\n            <div class=\"calm-meta-val\">标准路由拓扑</div>\n            <ul class=\"calm-list\">\n              <li><span>连接协议标准</span><span>通用配置链接</span></li>\n              <li><span>计费刷新频率</span><span>30 日周期重置</span></li>\n              <li><span>多端同时接入</span><span>最高支持 20 设备</span></li>\n              <li><span>技术工单通道</span><span>持续在线保障</span></li>\n            </ul>\n          </div>\n        </div>\n      </section>\n\n      \n      <section id=\"plans\" class=\"section-wrap\">\n        <div class=\"section-header\">\n          <span class=\"section-tag\">选择订阅</span>\n          <h2 class=\"section-title\">订阅方案清单</h2>\n          <p class=\"section-subtitle\">按月计费，年付享优惠。无隐藏资费。根据实际设备数量与用量灵活匹配。</p>\n        </div>\n\n        <div class=\"plans-stack\">\n          \n          \n          <article class=\"plan-card\">\n            <div class=\"plan-head-col\">\n              <h3>基础版</h3>\n              <div class=\"plan-price-box\">\n                <span class=\"plan-price-main\">¥15</span>\n                <span class=\"plan-price-unit\">/月</span>\n              </div>\n              <div class=\"plan-price-sub\">按年付仅需 ¥150/年</div>\n            </div>\n\n            <div class=\"plan-features-col\">\n              <div class=\"feature-item\">\n                <span class=\"feature-dot\"></span>\n                <span>每月 100GB 极速流量</span>\n              </div>\n              <div class=\"feature-item\">\n                <span class=\"feature-dot\"></span>\n                <span>支持 3 台设备同时在线</span>\n              </div>\n              <div class=\"feature-item\">\n                <span class=\"feature-dot\"></span>\n                <span>解锁基础流媒体</span>\n              </div>\n              <div class=\"feature-item\">\n                <span class=\"feature-dot\"></span>\n                <span>普通线路节点池</span>\n              </div>\n            </div>\n\n            <div class=\"plan-cta-col\">\n              <a href=\"#\" class=\"btn-select\">选订基础版</a>\n            </div>\n          </article>\n\n          \n          <article class=\"plan-card is-featured\">\n            <span class=\"featured-badge\">重点推荐</span>\n            <div class=\"plan-head-col\">\n              <h3>旗舰版</h3>\n              <div class=\"plan-price-box\">\n                <span class=\"plan-price-main\">¥35</span>\n                <span class=\"plan-price-unit\">/月</span>\n              </div>\n              <div class=\"plan-price-sub\">按年付仅需 ¥350/年</div>\n            </div>\n\n            <div class=\"plan-features-col\">\n              <div class=\"feature-item\">\n                <span class=\"feature-dot\"></span>\n                <span>每月 300GB 极速流量</span>\n              </div>\n              <div class=\"feature-item\">\n                <span class=\"feature-dot\"></span>\n                <span>支持 5 台设备同时在线</span>\n              </div>\n              <div class=\"feature-item\">\n                <span class=\"feature-dot\"></span>\n                <span>全节点原生流媒体解锁</span>\n              </div>\n              <div class=\"feature-item\">\n                <span class=\"feature-dot\"></span>\n                <span>IPLC 专线游戏加速优化</span>\n              </div>\n              <div class=\"feature-item\">\n                <span class=\"feature-dot\"></span>\n                <span>7x24 优先工单支持</span>\n              </div>\n            </div>\n\n            <div class=\"plan-cta-col\">\n              <a href=\"#\" class=\"btn-select\">选订旗舰版</a>\n            </div>\n          </article>\n\n          \n          <article class=\"plan-card\">\n            <div class=\"plan-head-col\">\n              <h3>团队版</h3>\n              <div class=\"plan-price-box\">\n                <span class=\"plan-price-main\">¥85</span>\n                <span class=\"plan-price-unit\">/月</span>\n              </div>\n              <div class=\"plan-price-sub\">按年付仅需 ¥850/年</div>\n            </div>\n\n            <div class=\"plan-features-col\">\n              <div class=\"feature-item\">\n                <span class=\"feature-dot\"></span>\n                <span>每月 1000GB 极速流量</span>\n              </div>\n              <div class=\"feature-item\">\n                <span class=\"feature-dot\"></span>\n                <span>支持 20 台设备同时在线</span>\n              </div>\n              <div class=\"feature-item\">\n                <span class=\"feature-dot\"></span>\n                <span>VIP 专属高带宽节点</span>\n              </div>\n              <div class=\"feature-item\">\n                <span class=\"feature-dot\"></span>\n                <span>支持企业定制路由</span>\n              </div>\n              <div class=\"feature-item\">\n                <span class=\"feature-dot\"></span>\n                <span>专属客户经理服务</span>\n              </div>\n            </div>\n\n            <div class=\"plan-cta-col\">\n              <a href=\"#\" class=\"btn-select\">选订团队版</a>\n            </div>\n          </article>\n\n        </div>\n      </section>\n\n      \n      <section id=\"setup\" class=\"section-wrap\">\n        <div class=\"section-header\">\n          <span class=\"section-tag\">标准化流程</span>\n          <h2 class=\"section-title\">三步完成节点接入</h2>\n          <p class=\"section-subtitle\">流程化指引。无须冗长调试。标准配置文件导入即用。</p>\n        </div>\n\n        <div class=\"steps-grid\">\n          <div class=\"step-card\">\n            <span class=\"step-num\">STEP 01</span>\n            <h3>获取订阅链接</h3>\n            <p>确定订阅周期并完成验证。系统即刻生成加密订阅 URL。该凭证归属个人使用，请妥善保管。</p>\n          </div>\n\n          <div class=\"step-card\">\n            <span class=\"step-num\">STEP 02</span>\n            <h3>导入配置工具</h3>\n            <p>复制订阅地址至受支持的客户端。点击更新节点列表。软件将自动解析全量可用线路与分组。</p>\n          </div>\n\n          <div class=\"step-card\">\n            <span class=\"step-num\">STEP 03</span>\n            <h3>设定路由分流</h3>\n            <p>按工作习惯切换规则分流模式。本地应用分流走直连，目标流量走代理节点。即刻生效。</p>\n          </div>\n        </div>\n\n        \n        <div id=\"clients\" class=\"clients-card\">\n          <div>\n            <h3>多平台终端兼容说明</h3>\n            <p>BLUEDAIR 采用通用标准下发订阅规则，不强制捆绑特定专有软件。用户可在不同操作系统的合规网络工具中导入配置。无需额外繁复插件。</p>\n          </div>\n          <div class=\"client-spec-badges\">\n            <span class=\"badge-pill\">Windows 环境兼容</span>\n            <span class=\"badge-pill\">macOS 系统兼容</span>\n            <span class=\"badge-pill\">iOS / iPadOS 快捷导入</span>\n            <span class=\"badge-pill\">Android 开放平台</span>\n            <span class=\"badge-pill\">Linux 守护进程适配</span>\n          </div>\n        </div>\n      </section>\n\n      \n      <section id=\"faq\" class=\"section-wrap\">\n        <div class=\"section-header\">\n          <span class=\"section-tag\">答疑汇总</span>\n          <h2 class=\"section-title\">常见问题解答</h2>\n          <p class=\"section-subtitle\">关于订阅生效、并发设备与流量结算的要点梳理。</p>\n        </div>\n\n        <div class=\"faq-wrapper\">\n          \n          <details class=\"faq-item\">\n            <summary class=\"faq-header\">\n              <h3>流量配额何时开始计算，如何重置？</h3>\n              <span class=\"faq-toggle-icon\">+</span>\n            </summary>\n            <div class=\"faq-body\">\n              流量自套餐激活之日起生效。每 30 天自动重置为初始额度。周期内未用完的流量不予累计结转至下一账期。\n            </div>\n          </details>\n\n          <details class=\"faq-item\">\n            <summary class=\"faq-header\">\n              <h3>超过套餐规定的设备数限制会发生什么？</h3>\n              <span class=\"faq-toggle-icon\">+</span>\n            </summary>\n            <div class=\"faq-body\">\n              系统以同时发起连接的活跃设备数为准。当并发连接数超过套餐限制时，后发起的连接将受限。可在多台设备中预先录入订阅凭据，错峰使用不受影响。\n            </div>\n          </details>\n\n          <details class=\"faq-item\">\n            <summary class=\"faq-header\">\n              <h3>旗舰版与团队版的优先服务包含哪些内容？</h3>\n              <span class=\"faq-toggle-icon\">+</span>\n            </summary>\n            <div class=\"faq-body\">\n              旗舰版享有 7x24 优先工单响应，处理订阅地址解析及节点可用性异常。团队版额外配备专属客户经理，协助制定企业路由规则与用量规划。\n            </div>\n          </details>\n\n          <details class=\"faq-item\">\n            <summary class=\"faq-header\">\n              <h3>更换使用终端时是否需要重新生成凭据？</h3>\n              <span class=\"faq-toggle-icon\">+</span>\n            </summary>\n            <div class=\"faq-body\">\n              不需要。将现有的订阅 URL 填入新设备的客户端并拉取节点列表即可。如怀疑订阅凭据泄露，可在管理面板重置并重新下发。\n            </div>\n          </details>\n\n        </div>\n      </section>\n\n    </div>\n  </main>\n\n  <footer class=\"site-footer\">\n    <div class=\"wrap footer-content\">\n      <div class=\"footer-brand\">BLUEDAIR</div>\n      <div class=\"footer-note\">订阅数据分流服务 · 规范配置 · 稳定交付</div>\n    </div>\n  </footer>",
